-    path 'CMakeLists.txt'
-    arguments  "-DCMAKE_TOOLCHAIN_FILE=cmake/toolchains/android.toolchain.cmake",
-        "-DANDROID_TOOLCHAIN=gcc",
-        "-DANDROID_STL=gnustl_static",
-        "-DANDROID_PLATFORM=android-24", // 24 is the highest so available in 12 ndk??
