-        installPrefix "${buildDir}/jniLibs/${runtimePlatform}"
+// macTAK G0 spike: `useTakRepo` restores the upstream takRepo-gated native build
+// (gradle-cmake-plugin + gov.tak.* runtime artifacts). Default off: compile Java-only
+// against public artifacts; the engine dylib is built by spike/g0's wrapper instead.
+def useTakRepo = project.findProperty('useTakRepo') == 'true'
+
+if(useTakRepo) {
+    externalNativeBuild {
+        path 'CMakeLists.txt'
+        arguments  "-DCMAKE_TOOLCHAIN_FILE=cmake/toolchains/android.toolchain.cmake",
+            "-DANDROID_TOOLCHAIN=gcc",
+            "-DANDROID_STL=gnustl_static",
+            "-DANDROID_PLATFORM=android-24", // 24 is the highest so available in 12 ndk??
+            "-DANDROID_ARM_NEON=ON"
+        cFlags "-D__GXX_EXPERIMENTAL_CXX0X__"
+        cppFlags "-fexceptions", "-frtti"
+        buildTarget 'install'
+        if(isJavaKernelBuild) {
+            installPrefix "${buildDir}/jniLibs/${runtimePlatform}"
+        }
     }
 }
 
