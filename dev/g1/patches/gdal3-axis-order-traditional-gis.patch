+    /**
+     * macTAK (G2.4b, trap #48): GDAL &gt;= 3 honours the authority's axis
+     * order, so an EPSG:4326 {@link SpatialReference} is lat,lon and every
+     * {@code TransformPoint(lon, lat)} in the engine (written against GDAL
+     * 2.x, which was always lon,lat) reads longitude as latitude. Pin the
+     * GDAL 2 behaviour on each SRS the engine transforms through. Call after
+     * the SRS is defined (import/WKT); a no-op on GDAL 2 bindings is not
+     * needed because this build only ever links GDAL 3.
+     *
+     * @return {@code srs}, for chaining
+     */
+    public static SpatialReference traditionalGisOrder(SpatialReference srs) {
+        if (srs != null)
+            srs.SetAxisMappingStrategy(org.gdal.osr.osrConstants.OAMS_TRADITIONAL_GIS_ORDER);
+        return srs;
+    }
